
# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name


# Session Configuration
SESSION_SECRET_KEY=your_session_secret_key


